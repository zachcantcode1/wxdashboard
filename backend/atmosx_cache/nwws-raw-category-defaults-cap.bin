            <value>2025-08-02T20:12:00-00:00...storm...066DEG...10KT...33.27,-105.61</value>
        </parameter>
        <parameter>
            <valueName>maxWindGust</valueName>
            <value>40 MPH</value>
        </parameter>
        <parameter>
            <valueName>maxHailSize</valueName>
            <value>0.88</value>
        </parameter>
