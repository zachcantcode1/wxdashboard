<alert xmlns="urn:oasis:names:tc:emergency:cap:1.2">
    <identifier>urn:oid:2.49.0.1.840.0.bb2ef0b3ca20a5381f4d9a3b7ff99a13d46711f2.001.1</identifier>
    <sender>w-nws.webmaster@noaa.gov</sender>
    <sent>2025-08-02T15:50:00-04:00</sent>
    <status>Actual</status>
