<alert xmlns="urn:oasis:names:tc:emergency:cap:1.2">
    <identifier>urn:oid:2.49.0.1.840.0.b3229457cde21e21efe19552e74a04075d898d9d.001.1</identifier>
    <sender>w-nws.webmaster@noaa.gov</sender>
