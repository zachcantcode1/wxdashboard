            <value>WWUS82 KTAE 080048</value>
        </parameter>
        <parameter>
            <valueName>NWSheadline</valueName>
            <value>A STRONG THUNDERSTORM WILL IMPACT CENTRAL TAYLOR COUNTY THROUGH 915 PM EDT</value>
        </parameter>
