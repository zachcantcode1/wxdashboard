            <value>WWUS82 KTAE 060008</value>
        </parameter>
        <parameter>
            <valueName>NWSheadline</valueName>
            <value>A STRONG THUNDERSTORM WILL IMPACT EASTERN GADSDEN AND CENTRAL LEON COUNTIES THROUGH 845 PM EDT</value>
