        </parameter>
        <parameter>
            <valueName>NWSheadline</valueName>
            <value>A STRONG THUNDERSTORM WILL IMPACT NORTHWESTERN GOGEBIC AND WEST CENTRAL ONTONAGON COUNTIES THROUGH 800 PM EDT/700 PM CDT/</value>
