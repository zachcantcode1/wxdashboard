<alert xmlns="urn:oasis:names:tc:emergency:cap:1.2">
    <identifier>urn:oid:2.49.0.1.840.0.74265077a1af1ff725674f369721f2ead66a155e.001.1</identifier>
    <sender>w-nws.webmaster@noaa.gov</sender>
