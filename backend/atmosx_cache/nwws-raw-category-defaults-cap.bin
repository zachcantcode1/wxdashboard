            <valueName>NWSheadline</valueName>
            <value>A STRONG THUNDERSTORM WILL IMPACT NORTHEASTERN MCKENZIE... SOUTHEASTERN WILLIAMS AND WEST CENTRAL MOUNTRAIL COUNTIES THROUGH 800 PM CDT</value>
        </parameter>
