<alert xmlns="urn:oasis:names:tc:emergency:cap:1.2">
    <identifier>urn:oid:2.49.0.1.840.0.95616592fc5ba26d5a0266f217efee771aa6b535.001.1</identifier>
    <sender>w-nws.webmaster@noaa.gov</sender>
