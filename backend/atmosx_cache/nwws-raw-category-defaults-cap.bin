087

XOUS55 KWBC 150052

CAPBOU

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<alert xmlns="urn:oasis:names:tc:emergency:cap:1.2">
    <identifier>urn:oid:2.49.0.1.840.0.0faf1db5577259fcb3d16a0cef15c61817b4c281.001.1</identifier>
    <sender>w-nws.webmaster@noaa.gov</sender>
    <sent>2025-08-14T18:52:00-06:00</sent>
    <status>Actual</status>
    <msgType>Alert</msgType>
    <scope>Public</scope>
    <code>IPAWSv1.0</code>
    <info>
        <language>en-US</language>
        <category>Met</category>
        <event>Special Weather Statement</event>
        <responseType>Execute</responseType>
        <urgency>Expected</urgency>
        <severity>Moderate</severity>
        <certainty>Observed</certainty>
        <eventCode>
            <valueName>SAME</valueName>
            <value>SPS</value>
        </eventCode>
        <eventCode>
            <valueName>NationalWeatherService</valueName>
            <value>SPS</value>
        </eventCode>
        <effective>2025-08-14T18:52:00-06:00</effective>
        <onset>2025-08-14T18:52:00-06:00</onset>
        <expires>2025-08-14T19:30:00-06:00</expires>
        <senderName>NWS Denver CO</senderName>
        <headline>Special Weather Statement issued August 14 at 6:52PM MDT by NWS Denver CO</headline>
        <description>At 652 PM MDT, Doppler radar was tracking an area of strong
thunderstorms extending from 9 miles northeast of Kutch to near Wild
Horse Point, or extending from 19 miles south of Limon to 50 miles
south of Limon, moving northeast at 25 mph.

HAZARD...Wind gusts up to 50 mph and half inch size hail.

SOURCE...Radar indicated.

IMPACT...Gusty winds could knock down tree limbs and blow around
unsecured objects. Minor damage to outdoor objects is possible.

Locations impacted include...
Hugo, Karval, Boyero and Wild Horse Point.
</description>
        <instruction>If outdoors, consider seeking shelter inside a building.

Prepare for sudden gusty winds. Secure loose objects and move to a
safe shelter inside a building or vehicle.</instruction>
        <web>http://www.weather.gov</web>
        <parameter>
            <valueName>AWIPSidentifier</valueName>
            <value>SPSBOU</value>
        </parameter>
        <parameter>
            <valueName>WMOidentifier</valueName>
            <value>WWUS85 KBOU 150052</value>
        </parameter>
        <parameter>
            <valueName>NWSheadline</valueName>
            <value>AN AREA OF STRONG THUNDERSTORMS WILL IMPACT EASTERN ELBERT AND SOUTHEASTERN LINCOLN COUNTIES UNTIL 730 PM MDT</value>
        </parameter>
