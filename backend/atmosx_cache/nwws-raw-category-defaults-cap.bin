            <value>WWUS83 KDVN 070058</value>
        </parameter>
        <parameter>
            <valueName>NWSheadline</valueName>
            <value>Slow-moving thunderstorms will impact portions of northeastern Warren, central Mercer and southwestern Rock Island Counties through 845 PM CDT</value>
        </parameter>
        <parameter>
            <valueName>eventMotionDescription</valueName>
            <value>2025-08-07T00:56:00-00:00...storm...274DEG...2KT...41.34,-91.01 40.94,-90.6</value>
