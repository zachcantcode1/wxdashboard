<alert xmlns="urn:oasis:names:tc:emergency:cap:1.2">
    <identifier>urn:oid:2.49.0.1.840.0.3c4c237e794325275c51f518b4a478eec120017b.001.1</identifier>
    <sender>w-nws.webmaster@noaa.gov</sender>
