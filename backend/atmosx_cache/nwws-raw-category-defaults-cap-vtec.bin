CAPOAX

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<alert xmlns="urn:oasis:names:tc:emergency:cap:1.2">
    <identifier>urn:oid:2.49.0.1.840.0.874326e2e108f6d34beb97458deef0442583f037.001.1</identifier>
