        <event>Tsunami Watch</event>
        <responseType>Monitor</responseType>
        <urgency>Future</urgency>
        <severity>Extreme</severity>
        <certainty>Possible</certainty>
        <eventCode>
            <valueName>SAME</valueName>
            <value>TSA</value>
