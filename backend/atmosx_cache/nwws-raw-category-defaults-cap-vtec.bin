718

XOUS55 KWBC 021937

CAPPSR

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<alert xmlns="urn:oasis:names:tc:emergency:cap:1.2">
    <identifier>urn:oid:2.49.0.1.840.0.2887afee7f6085d3290aa61fc28e48ec6382914d.001.2</identifier>
    <sender>w-nws.webmaster@noaa.gov</sender>
    <sent>2025-08-02T12:37:00-07:00</sent>
    <status>Actual</status>
