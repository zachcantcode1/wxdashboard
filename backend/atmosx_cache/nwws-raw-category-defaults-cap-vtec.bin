            <value>Imminent Threat</value>
        </parameter>
        <parameter>
            <valueName>CMAMtext</valueName>
            <value>NWS: FLASH FLOOD WARNING this area til 5:00 PM MDT. Avoid flooded areas.</value>
        </parameter>
        <parameter>
            <valueName>CMAMlongtext</valueName>
            <value>National Weather Service: A FLASH FLOOD WARNING is in effect for this area until 5:00 PM MDT. This is a dangerous and life-threatening situation. Do not attempt to travel unless you are fleeing an area subject to flooding or under an evacuation order.</value>
        </parameter>
        <area>
            <areaDesc>Grant, NM</areaDesc>
            <polygon>32.92,-108.17 32.92,-108.14 32.93,-108.12 32.93,-108.1 32.96,-108.1 32.98,-108.05 32.96,-108.01 32.87,-107.96 32.84,-107.99 32.86,-108.03 32.87,-108.13 32.92,-108.17</polygon>
