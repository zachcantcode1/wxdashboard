        <event>Coastal Flood Advisory</event>
        <responseType>Monitor</responseType>
        <urgency>Expected</urgency>
        <severity>Minor</severity>
        <certainty>Likely</certainty>
        <eventCode>
            <valueName>SAME</valueName>
