<alert xmlns="urn:oasis:names:tc:emergency:cap:1.2">
    <identifier>urn:oid:2.49.0.1.840.0.c281e2b1238f531a8241f33d41ab8d05c932d737.001.1</identifier>
    <sender>w-nws.webmaster@noaa.gov</sender>
