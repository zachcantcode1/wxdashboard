            <polygon>37.96,-83.93 38.0,-83.9 38.02,-83.88 38.02,-83.85 38.01,-83.82 38.01,-83.81 37.99,-83.78 37.97,-83.78 37.96,-83.78 37.96,-83.77 37.93,-83.77 37.93,-83.78 37.94,-83.81 37.94,-83.9 37.95,-83.93 37.96,-83.93</polygon>
